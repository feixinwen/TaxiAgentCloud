# taxiagent-ci-secrets 键名模板（值必须为空，真实文件在服务器 /opt/taxiagent/secrets/ci-infra.env，权限 0600）
# 应用：scripts/server/apply-ci-infra-secrets.sh（或 scripts/server/deploy-ci-infra.sh 首次运行时自动生成随机值）
#
# 这些凭据只作用于 taxiagent-ci namespace 的独立测试实例，与 taxiagent 运行时数据实例
# 完全隔离。密码建议使用 openssl rand -hex 16 类随机值——初始化脚本会把值直接拼进 SQL，
# 含单引号的密码会破坏首次初始化。

CI_MYSQL_ADMIN_USER=
CI_MYSQL_ADMIN_PASSWORD=
CI_REDIS_PASSWORD=
CI_MONGODB_USER=
CI_MONGODB_PASSWORD=
