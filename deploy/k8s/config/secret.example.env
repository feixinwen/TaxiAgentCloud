# taxiagent-secrets 键名模板（值必须为空，真实文件在服务器 /opt/taxiagent/secrets/taxiagent.env，权限 0600）
# 应用：scripts/server/apply-taxiagent-secrets.sh
#
# TAXIAGENT_DB_PASSWORD 是六个业务库共享的应用账号密码，脚本会把它展开成
# USER_DB_PASSWORD / AUTH_DB_PASSWORD / ORDER_DB_PASSWORD / TICKET_DB_PASSWORD /
# RAG_DB_PASSWORD / AGENT_DB_PASSWORD 六个键注入 Secret。
# API 密钥留空时脚本会告警但继续；服务运行期调用对应外部 API 才需要真实值。

MYSQL_ROOT_PASSWORD=
TAXIAGENT_DB_PASSWORD=
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=
NACOS_PASSWORD=
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
AMAP_KEY=
QWEATHER_KEY=
QWEATHER_TOKEN=
