# Copy this file to .env before starting Nacos. Do not commit the real .env file.
# NACOS_AUTH_TOKEN must be Base64 encoded and decode to at least 32 bytes.
NACOS_AUTH_TOKEN=

# Use private, non-default values to identify trusted Nacos server requests.
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=

# Optional client credentials used by scripts/local-dev.ps1 and Spring services.
# Keep NACOS_PASSWORD empty only when the local Nacos account has no password.
NACOS_USERNAME=nacos
NACOS_PASSWORD=
